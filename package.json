{
  "name": "@vilius/email-validator",
  "version": "1.0.0",
  "description": "Advanced email verification and classification tool with syntax, MX, SMTP validation, and department detection",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node examples/basic-usage.ts",
    "example": "ts-node examples/cli.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "email-validator",
    "email-verification",
    "email-validation",
    "mx-check",
    "smtp-check",
    "disposable-email",
    "email-classification",
    "role-based-email"
  ],
  "author": "Vilius Brazdeikis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/email-validator.git"
  },
  "dependencies": {
    "@devmehq/email-validator-js": "^2.10.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
